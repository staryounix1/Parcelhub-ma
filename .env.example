# ParcelHub MA Secrets Configuration
# Configure your real credentials in the Secrets panel in AI Studio.
# Never commit a real .env file to version control.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://demo-project.supabase.co

# Supabase Public Anon Key (protected by PostgreSQL Row Level Security)
SUPABASE_ANON_KEY=demo_supabase_anon_key

# Meta WhatsApp Cloud API (Optional for live template sending; server Edge Function recommended for production)
WHATSAPP_PHONE_NUMBER_ID=demo_phone_number_id
WHATSAPP_CLOUD_TOKEN=demo_whatsapp_cloud_token
